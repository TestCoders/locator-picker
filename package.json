{
  "name": "locator-picker",
  "description": "Kopieer met één klik een stabiele, leesbare locator naar het clipboard.",
  "private": true,
  "version": "0.20.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "lint:firefox": "wxt build -b firefox && web-ext lint --source-dir .output/firefox-mv3 --self-hosted",
    "test:e2e:firefox": "wxt zip -b firefox && playwright test -c playwright.firefox.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/selenium-webdriver": "4.35.7",
    "happy-dom": "21.0.4",
    "jsdom": "31.0.1",
    "selenium-webdriver": "4.52.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  }
}
