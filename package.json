{
  "name": "locator-picker",
  "description": "Kopieer met één klik een stabiele, leesbare locator naar het clipboard.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wxt": "0.21.5"
  }
}
